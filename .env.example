# 端口
PORT=3000

# 生产环境设为 production（启用 Secure Cookie、HSTS 与静态资源缓存）
NODE_ENV=production

# 管理员账号（必填！部署时务必改成你自己的账号密码）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=请修改为你的管理员密码

# 登录会话有效期（毫秒），默认 7 天
SESSION_TTL=604800000

# 图片存储目录（容器部署使用持久化目录）
UPLOAD_DIR=uploads

# 用户头像存储目录
AVATAR_DIR=avatars

# 元数据文件
DATA_FILE=data.json

# SQLite 数据库文件
DATABASE_FILE=memesharing.db

# 单张图片大小上限（字节），默认 50MB
MAX_FILE_SIZE=52428800
