{
  "id": "/",
  "name": "Meme.Share 表情包分享",
  "short_name": "Meme.Share",
  "description": "收藏、上传与分享表情包",
  "lang": "zh-CN",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#090d16",
  "theme_color": "#090d16",
  "icons": [
    { "src": "/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "share_target": {
    "action": "/share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "images",
          "accept": ["*/*", "application/octet-stream", "image/*", "video/webm", ".jpg", ".jpeg", ".png", ".gif", ".webp", ".avif", ".webm"]
        }
      ]
    }
  }
}
